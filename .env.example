DATABASE_URL=postgresql+psycopg://lubriflow:change-me@localhost:5432/lubriflow
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_ORIGIN=http://localhost:3000
ENVIRONMENT=development
DOCUMENT_ROOT=./var/documents
# Optional S3 storage; use a private bucket with encryption and versioning.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=me-central-1
AZURE_DOCUMENT_ENDPOINT=
AZURE_DOCUMENT_KEY=
MFA_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_BUCKET=
BACKUP_ENDPOINT_URL=
# Supplier messaging is off until providers and an explicit tenant allowlist are configured.
MESSAGING_LIVE=false
MESSAGING_TENANT_IDS=[]
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_TEMPLATES={}

# Optional single identity provider; bind existing staff before enabling OIDC_ONLY.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SESSION_SECRET=
OIDC_REQUIRED_AMR=["mfa"]
OIDC_ONLY=false
